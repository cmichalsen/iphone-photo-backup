<Window x:Class="PhotoBackup.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iPhone Photo Backup" Width="760" Height="600" MinWidth="620" MinHeight="460"
        FontSize="14" Closing="OnClosing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock Text="Back up to:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button x:Name="OpenDestButton" DockPanel.Dock="Right" Content="Open folder" Padding="10,4" Margin="8,0,0,0" Click="OnOpenDestination"/>
            <TextBox x:Name="DestinationBox" Padding="4" LostFocus="OnDestinationChanged"/>
        </DockPanel>

        <CheckBox x:Name="RehashBox" Grid.Row="1" Margin="0,10,0,0" Click="OnDestinationChanged"
                  Content="Re-read every file on the NAS before deleting it from the phone (slower, safest)"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="BackupButton" Content="Back up now" Padding="16,8" FontWeight="SemiBold" Click="OnBackup"/>
            <Button x:Name="PreviewButton" Content="Preview delete" Padding="16,8" Margin="8,0,0,0" Click="OnPreview"/>
            <Button x:Name="DeleteButton" Content="Delete verified from phone…" Padding="16,8" Margin="8,0,0,0" Click="OnDelete"/>
            <Button x:Name="CancelButton" Content="Cancel" Padding="16,8" Margin="8,0,0,0" IsEnabled="False" Click="OnCancel"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,14,0,6" TextWrapping="Wrap"
                   Text="Plug in and unlock the iPhone, then choose Back up now."/>

        <StackPanel Grid.Row="4">
            <ProgressBar x:Name="OverallBar" Height="16"/>
            <ProgressBar x:Name="FileBar" Height="6" Margin="0,4,0,0"/>
            <TextBlock x:Name="CountsText" Margin="0,6,0,0" Foreground="#555"/>
        </StackPanel>

        <TextBox x:Name="LogBox" Grid.Row="5" Margin="0,10,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>

        <TextBlock Grid.Row="6" Margin="0,8,0,0">
            <Hyperlink Click="OnOpenLogs">Open log folder</Hyperlink>
        </TextBlock>
    </Grid>
</Window>
